# Copiá este archivo como ".env" y completá los dos primeros valores.
# El archivo .env tiene secretos: no se sube a git ni se comparte.

# Token del bot (Portal de Desarrolladores > Bot > Reset Token)
DISCORD_TOKEN=

# ID del servidor (clic derecho al ícono del servidor > Copiar ID del servidor)
GUILD_ID=

# --- Opcionales ---

# Puerto donde la página pide los datos
PORT=3001

# Zona horaria para los días de la racha y la semana
TIMEZONE=America/Argentina/Buenos_Aires

# IDs de personas que NO querés que aparezcan, separados por coma
EXCLUDE_IDS=

# true = en voz solo suma si además está jugando. false = suma cualquier tiempo en voz.
COUNT_VOICE_ONLY_WHEN_PLAYING=false

# Minutos mínimos en voz en un día para que cuente en la racha
STREAK_MIN_MINUTES=10

# --- Para cuando la página esté publicada en internet (ver PUBLICAR.md) ---
# Dirección del Worker de Cloudflare terminada en /api/push, y la contraseña que cargaste allá.
# Si los dejás vacíos, el bot solo sirve los datos en tu propia PC.
PUSH_URL=
PUSH_TOKEN=
# Cada cuántos segundos manda los datos (mínimo 90)
PUSH_EVERY_SECONDS=120

# Quién puede leer los datos desde un navegador. "*" = cualquier página.
# Cuando publiques la web, podés poner su dirección (ej: https://gamingzone.pages.dev)
ALLOWED_ORIGIN=*
